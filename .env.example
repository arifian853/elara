# ── Database Connection (asyncpg via Supabase Pooler) ───────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=postgresql://postgres.your-project:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Groq (Generation + Query Rewrite) ──────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1000

# ── Google AI Studio (Embedding + Reranker) ────────────────────
GEMINI_API_KEY=AIzaSy...
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
RERANKER_MODEL=gemma-4-26b-a4b-it

# ── Cloudflare R2 (Private Bucket) ─────────────────────────────
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_ENDPOINT=https://...r2.cloudflarestorage.com
R2_BUCKET=elara-chatbot
R2_REGION=auto

# ── GitHub API (Opsional: 60 → 5000 req/jam) ──────────────────
GITHUB_TOKEN=ghp_...

# ── Telegram Bridge (Outbound Only) ────────────────────────────
TELEGRAM_BOT_TOKEN=...
OWNER_CHAT_ID=...

# ── Admin, Environment & CORS ──────────────────────────────────
ADMIN_TOKEN=your_secure_admin_token_here
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
ENABLE_DOCS=true

# ── RAG Tuning ─────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RERANK_TOP_K=3
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=800
CHUNK_OVERLAP=0.1
